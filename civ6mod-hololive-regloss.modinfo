<?xml version="1.0" encoding="utf-8"?>
<Mod id="fb7b87a1-b33e-48a5-8e91-b952fdae6a6f" version="1">
	<Properties>
		<Name>Hololive ReGLOSS</Name>
		<Teaser>Adds a new civilization inspired by hololive ReGLOSS.</Teaser>
		<Description>Adds a new civilization inspired by hololive ReGLOSS.[NEWLINE][NEWLINE]hololive ReGLOSSをモチーフにした新しい文明を追加する。</Description>
		<Authors>yu-yami</Authors>
		<CompatibleVersions>1.2,2.0</CompatibleVersions>
	</Properties>
	<Dependencies>
		<Mod id="4873eb62-8ccc-4574-b784-dda455e74e68" title="Expansion: Gathering Storm" />
	</Dependencies>
	<ActionCriteria>
		<!-- Firaxis公式KublaiKhan_Vietnam.modinfoの同名クライテリアをそのまま踏襲(2026-09-20実機ファイルで確認済み) -->
		<Criteria id="Monopolies_Mode">
			<ConfigurationValueMatches>
				<Group>Game</Group>
				<ConfigurationId>GAMEMODE_MONOPOLIES</ConfigurationId>
				<Value>1</Value>
			</ConfigurationValueMatches>
		</Criteria>
	</ActionCriteria>
	<FrontEndActions>
		<UpdateDatabase id="Config">
			<File>XML/Config.xml</File>
		</UpdateDatabase>
		<UpdateColors id="ConfigColors">
			<File>XML/Colors.xml</File>
		</UpdateColors>
		<UpdateText id="ConfigText">
			<File>Text/en_US/Text.xml</File>
			<File>Text/ja_JP/Text.xml</File>
		</UpdateText>
		<UpdateIcons id="ConfigIcons">
			<File>Art/Icons/Icons.xml</File>
		</UpdateIcons>
		<UpdateArt id="ConfigArt">
			<File>civ6mod-hololive-regloss.dep</File>
		</UpdateArt>
	</FrontEndActions>
	<InGameActions>
		<UpdateDatabase id="Gameplay">
			<File>XML/Civilizations.xml</File>
			<File>XML/Leaders.xml</File>
		</UpdateDatabase>
		<UpdateDatabase id="GameplayMonopolies" criteria="Monopolies_Mode">
			<File>XML/Leaders_Monopolies.xml</File>
		</UpdateDatabase>
		<UpdateColors id="Colors">
			<File>XML/Colors.xml</File>
		</UpdateColors>
		<UpdateText id="Text">
			<File>Text/en_US/Text.xml</File>
			<File>Text/ja_JP/Text.xml</File>
		</UpdateText>
		<UpdateIcons id="Icons">
			<File>Art/Icons/Icons.xml</File>
		</UpdateIcons>
		<UpdateArt id="Art">
			<File>civ6mod-hololive-regloss.dep</File>
		</UpdateArt>
	</InGameActions>
	<Files>
		<File>XML/Civilizations.xml</File>
		<File>XML/Leaders.xml</File>
		<File>XML/Leaders_Monopolies.xml</File>
		<File>XML/Colors.xml</File>
		<File>XML/Config.xml</File>
		<File>Text/en_US/Text.xml</File>
		<File>Text/ja_JP/Text.xml</File>
		<File>Art/Icons/Icons.xml</File>
		<File>ArtDefs/Leaders.artdef</File>
		<File>ArtDefs/FallbackLeaders.artdef</File>
		<File>civ6mod-hololive-regloss.dep</File>
		<File>Platforms/Windows/BLPs/UI/RegLoss_Icons.blp</File>
		<File>Platforms/MacOS/BLPs/UI/RegLoss_Icons.blp</File>
		<File>Platforms/Windows/BLPs/LeaderFallbackImages.blp</File>
		<File>Platforms/MacOS/BLPs/LeaderFallbackImages.blp</File>
	</Files>
</Mod>
