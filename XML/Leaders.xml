			<OwnerRequirementSetId>ON_TURN_STARTED</OwnerRequirementSetId>
			<SubjectRequirementSetId>REGLOSS_ICHIJOU_RIRIKA_REQSET_IS_WARMONGER</SubjectRequirementSetId>
		</Row>
		<Row>
			<ModifierId>REGLOSS_ICHIJOU_RIRIKA_AGENDA_GRIEVANCE_DECAY</ModifierId>
			<ModifierType>MODIFIER_PLAYER_ADJUST_GRIEVANCE_DECAY</ModifierType>
		</Row>
		<Row>
			<ModifierId>REGLOSS_ICHIJOU_RIRIKA_UA_TRADE_ATTACH</ModifierId>
			<ModifierType>MODIFIER_PLAYER_CITIES_ATTACH_MODIFIER</ModifierType>
		</Row>
		<Row>
			<ModifierId>REGLOSS_ICHIJOU_RIRIKA_UA_TRADE_CAPACITY</ModifierId>
			<ModifierType>MODIFIER_PLAYER_ADJUST_TRADE_ROUTE_CAPACITY</ModifierType>
			<SubjectRequirementSetId>REGLOSS_ICHIJOU_RIRIKA_REQSET_TRADE_BOTH_BUILDINGS</SubjectRequirementSetId>
		</Row>
		<Row>
			<ModifierId>REGLOSS_ICHIJOU_RIRIKA_UA_TRADE_YIELD_FOOD</ModifierId>
			<ModifierType>MODIFIER_PLAYER_ADJUST_TRADE_ROUTE_YIELD</ModifierType>
